# Copy this file to .env. Keep real API credentials out of version control.
API_KEY=
API_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Keep True while testing. Change to False only after verifying the setup.
SIMULATION_MODE=True

# A single buy uses this USDT amount. It cannot exceed MAX_ORDER_USDT.
ORDER_BUDGET_USDT=10
MAX_ORDER_USDT=10
MAX_OPEN_POSITIONS=3
CHECK_INTERVAL_MINUTES=15